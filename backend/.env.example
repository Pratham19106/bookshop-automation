# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# Supabase Postgres connection string: Project Settings -> Database -> Connection string.
#  - Running the API as a normal server (npm start / Render): the "Session pooler" or "Direct" URL (port 5432).
#  - Serverless (Vercel functions): the "Transaction pooler" URL (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Tests and the UI smoke test create (and drop) throwaway schemas here. Use a separate project or database if you can,
# and a session/direct URL (port 5432). Falls back to DATABASE_URL when unset.
TEST_DATABASE_URL=

# Shop's offset from UTC in minutes (India = 330); used to bucket sales into local calendar days.
TZ_OFFSET_MINUTES=330
SESSION_HOURS=12
# Set to 1 when the site is served over HTTPS (any hosted deployment).
COOKIE_SECURE=0
# Only if the frontend is served from a different origin than the API (comma-separated).
CORS_ORIGINS=
