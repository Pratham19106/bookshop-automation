{
  "name": "bookshop-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Bookshop Automation System - catalogue, billing, inventory, restocking, suppliers, dashboard, phone orders",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate-cli.js",
    "seed": "node src/db/seed-cli.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "backup": "node scripts/backup.js",
    "create-owner": "node scripts/create-owner.js",
    "test:e2e": "node e2e/ui.e2e.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.15.0"
  }
}
